{
  "name": "@kozmof/reed",
  "version": "1.0.3",
  "private": false,
  "description": "A fast, immutable text engine for building editors, built on a piece table and usable with any UI framework.",
  "keywords": [
    "document",
    "immutable",
    "piece-table",
    "text-buffer",
    "text-editor"
  ],
  "homepage": "https://github.com/kozmof/reed#readme",
  "bugs": {
    "url": "https://github.com/kozmof/reed/issues"
  },
  "license": "MIT",
  "author": "Kozo Oeda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozmof/reed.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/reed.js",
  "module": "./dist/reed.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/reed.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build && tsc -p tsconfig.types.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:perf:watch": "vitest --config vitest.perf.config.ts",
    "coverage": "vitest run --coverage",
    "gen-fixture": "npx tsx test-utils/gen-fixture.ts",
    "bench": "npx tsx test-utils/benchmarks/bench.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pack:home": "pnpm pack --pack-destination ~",
    "pack:check": "pnpm pack:home && pnpm pack:check-compare",
    "preflight": "pnpm publish --dry-run",
    "pack:check-name": "v=$(echo $npm_package_version) && name='kozmof-reed-'$v && echo $name",
    "pack:check-compare": "name=$(pnpm run --silent pack:check-name) && bash scripts/check-package-contents.sh ~/$name.tgz"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.76.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
